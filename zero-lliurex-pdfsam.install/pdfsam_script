#!/bin/bash


ACTION="$1"
PKGNAME="$2"
shift
source /usr/share/zero-lliurex-pdfsam/pdfsam.url

PACKAGE_LIST=$@
DEST_DOWNLOAD=$(mktemp --suffix .deb)
case $ACTION in

	download)
		echo 0
	;;
	getStatus)
		TEST=$( dpkg-query -s  $PKGNAME 2> /dev/null| grep Status | cut -d " " -f 4 )
		if [ "$TEST" == 'installed' ];then
			echo 0
		fi
		echo 1
	;;
	installPackage)
		wget ${PDFSAM_URL} -O ${DEST_DOWNLOAD}
		dpkg -i ${DEST_DOWNLOAD}
		rm ${DEST_DOWNLOAD}
	;;
	remove)
		apt-get remove -y $PKGNAME
		TEST=$( dpkg-query -s  $PKGNAME 2> /dev/null| grep Status | cut -d " " -f 4 )
		if [ "$TEST" == 'installed' ];then
			exit 1
		fi
	;;	
esac	

exit 0
